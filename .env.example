# =============================================================
# AI Influencer Outreach System — Environment Configuration
# =============================================================
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.
# =============================================================

# YouTube Data API v3 Key (free tier: 10,000 units/day)
# Get one at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY= your_YOUTUBE_api_key_here

# Google Gemini API Key (free tier: 60 requests/minute)
# Get one at: https://aistudio.google.com/apikey
# Use EITHER Gemini OR HuggingFace — you don't need both
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace Inference API Key (free alternative to Gemini: 1,000 req/day)
# Uses Mistral-7B-Instruct — no GPU needed, works great for message generation
# Get one at: https://huggingface.co/settings/tokens  (create token with 'Read' scope)

HUGGINGFACE_API_KEY= your_HF_api_key_here

# Email Configuration (optional — only needed for real sending)
SENDER_EMAIL=your_gmail
SENDER_PASSWORD=your_gmail_app_password_herg

# Dry Run Mode (True = simulate sending, False = real sending)
DRY_RUN=True
